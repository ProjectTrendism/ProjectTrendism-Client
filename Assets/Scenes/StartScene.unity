  m_text: "\uB9C8\uC744\uC744 \uD0D0\uD5D8\uD558\uBA70 NPC\uC640 \uB300\uD654\uD558\uACE0
    \uB2E4\uC591\uD55C \uD0A4\uC6CC\uB4DC\uB97C \uC218\uC9D1\uD558\uC138\uC694.\n\n\uC218\uC9D1\uD55C
    \uD0A4\uC6CC\uB4DC\uB294 \uC81C\uC791 \uB2E8\uACC4\uC5D0\uC11C \uC544\uC774\uD15C\uC744
    \uB9CC\uB4DC\uB294 \uB370 \uC0AC\uC6A9\uB429\uB2C8\uB2E4.\n\uC544\uC774\uD15C\uC758
    \uAC00\uCE58\uB294 \uD604\uC7AC \uC720\uD589, \uD0A4\uC6CC\uB4DC \uC870\uD569,
    \uB4F1\uAE09\uC5D0 \uB530\uB77C \uB2EC\uB77C\uC9D1\uB2C8\uB2E4.\n\n\uD310\uB9E4
    \uB2E8\uACC4\uC5D0\uC11C\uB294 \uAC00\uACA9\uACFC \uC218\uB7C9\uC744 \uC815\uD574
    \uC218\uC775\uC744 \uC5BB\uC2B5\uB2C8\uB2E4.\n\n\uD0D0\uD5D8 \u2192 \uC81C\uC791
    \u2192 \uD310\uB9E4 \u2192 \uC815\uC0B0\uC744 \uBC18\uBCF5\uD558\uBA70\n\uB354
